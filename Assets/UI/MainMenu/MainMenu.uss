:root {
}

.menuRegularButton {
    width: 320px;
    height: 80px;
    margin-top: 0;
    margin-bottom: 0;
    font-size: 32px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    border-radius: 5px;
    color: rgb(29, 29, 29);
    background-image: url("project://database/Assets/UI/GameUI/texture/button_background.png?fileID=2800000&guid=87bcef70b8c104272b7aaf2400efc56c&type=3#button_background");
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
    -unity-font-definition: url("project://database/Assets/UI/GameUI/font/VT323-Regular.ttf?fileID=12800000&guid=8c2ab64ad12824a55827b2ea2f868ae3&type=3#VT323-Regular");
    -unity-text-outline-color: rgb(0, 0, 0);
    -unity-text-outline-width: 1.2px;
}

.menuRegularButton:hover {
    scale: 1.05 1.05;
    transition-duration: 0.4s;
}

.settings-slider .unity-base-slider__dragger {
    background-color: rgb(190, 161, 126);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
}

.leaderboard-row {
    flex-direction: row;
    padding-top: 8px;
    padding-bottom: 8px;
    padding-right: 10px;
    padding-left: 10px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(139, 69, 19);
    -unity-text-align: upper-left;
    align-items: center;
}

.leaderboard-text {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=4beb055f07aaff244873dec698d0363e&type=3#Roboto-Bold");
    color: rgb(62, 39, 35);
    font-size: 18px;
}

.rank-gold {
    background-color: rgba(255, 215, 0, 0.47);
}

.rank-silver {
    background-color: rgba(192, 192, 192, 0.47);
}

.rank-bronze {
    background-color: rgba(205, 127, 50, 0.47);
}

.rank-current-player {
    background-color: rgba(227, 86, 25, 0.2);
    border-left-color: rgb(227, 86, 25);
    border-left-width: 4px;
}

.custom-dropdown {
}

.custom-dropdown .unity-base-field__input {
    background-color: rgb(219, 210, 193);
    border-top-width: 1.5px;
    border-right-width: 1.5px;
    border-bottom-width: 1.5px;
    border-left-width: 1.5px;
    border-left-color: rgb(74, 51, 35);
    border-right-color: rgb(74, 51, 35);
    border-top-color: rgb(74, 51, 35);
    border-bottom-color: rgb(74, 51, 35);
}

.custom-dropdown .unity-text-element {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Examples%20&%20Extras/Fonts/Roboto-Bold.ttf?fileID=12800000&guid=4beb055f07aaff244873dec698d0363e&type=3#Roboto-Bold");
    color: rgb(74, 51, 35);
    font-size: 16px;
    -unity-text-outline-width: 1.1px;
    -unity-text-outline-color: rgb(74, 51, 35);
}

#close-leaderboard-button:hover {
    scale: 1.1 1.1;
}

#level-dropdown:hover {
    scale: 1 1;
    -unity-background-image-tint-color: rgb(229, 229, 229);
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(74, 51, 35);
    border-right-color: rgb(74, 51, 35);
    border-top-color: rgb(74, 51, 35);
    border-bottom-color: rgb(74, 51, 35);
}

#close-settings-button:hover {
    scale: 1.1 1.1;
}
