<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/GameUI/GameUI.uss?fileID=7433441132597879392&amp;guid=2907b9b6607144e8c90d62cb09f0a841&amp;type=3" />
    <ui:VisualElement name="root-container" style="flex-grow: 1;">
        <ui:VisualElement name="hud-container" class="interactive" style="flex-grow: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); background-color: rgba(204, 131, 0, 0); width: 100%; height: 15%; flex-direction: row; padding-right: 40px; padding-top: 30px; margin-top: 0; padding-left: 80px; -unity-slice-scale: 1px; justify-content: space-between; align-items: center;">
            <ui:VisualElement name="time-mood-container" style="flex-grow: 0; flex-direction: column; background-image: url(&quot;project://database/Assets/UI/GameUI/texture/HUD_background.png?fileID=2800000&amp;guid=e275f6ae9366641e0853bdb1e66958b4&amp;type=3#HUD_background&quot;); width: 400px; height: 120px;">
                <ui:VisualElement name="timer-row" style="flex-grow: 0; flex-direction: row; align-items: center; -unity-text-align: middle-left; justify-content: center; margin-top: 10px;">
                    <ui:VisualElement name="clock-icon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI/GameUI/texture/clock.png?fileID=2800000&amp;guid=c627de3b56a6c4e5588aabd9bf2eb30f&amp;type=3#clock&quot;); background-size: 45px 45px; height: 50px; -unity-background-image-tint-color: rgb(224, 224, 224); width: 50px;" />
                    <ui:Label text="05:00:000" name="timer-label" style="font-size: 50px; align-items: center; align-self: flex-start; padding-left: 38px; border-left-color: rgb(255, 255, 255); border-right-color: rgb(255, 255, 255); border-top-color: rgb(255, 255, 255); border-bottom-color: rgb(255, 255, 255); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; color: rgb(22, 22, 22); padding-right: 0; align-content: center; margin-right: 0; justify-content: center; -unity-font-definition: url(&quot;project://database/Assets/UI/GameUI/font/monogram.ttf?fileID=12800000&amp;guid=ca84cd843ad1740b29cdfc31daaf8acd&amp;type=3#monogram&quot;); -unity-text-outline-color: rgb(0, 0, 0); -unity-text-outline-width: 2px; padding-top: 5px; padding-bottom: 0; margin-bottom: 0; margin-top: 0; margin-left: 0; -unity-text-align: middle-left;" />
                </ui:VisualElement>
                <ui:VisualElement name="mood-row" style="flex-grow: 0; flex-direction: row; justify-content: center;">
                    <ui:VisualElement name="mood-icon" style="flex-grow: 0; background-image: url(&quot;project://database/Assets/UI/GameUI/texture/mood-icon.png?fileID=2800000&amp;guid=335930558cef74eb6b95117baecd7222&amp;type=3#mood-icon&quot;); background-size: 50px 50px; width: 50px; height: 50px; margin-right: 12px;" />
                    <ui:VisualElement name="mood-bar-container" style="flex-grow: 0; width: 200px; height: 24px; background-color: rgb(0, 0, 0); margin-top: 10px;">
                        <ui:Label text="100" name="mood-display-label" style="font-size: 30px; color: rgb(0, 255, 25); border-left-color: rgb(0, 255, 25); border-right-color: rgb(0, 255, 25); border-top-color: rgb(0, 255, 25); border-bottom-color: rgb(0, 255, 25); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; width: 100px; height: 45px; padding-left: 15px; display: none; position: absolute;" />
                        <ui:VisualElement name="mood-bar-fill" style="flex-grow: 1; width: 100%; height: 100%; color: rgb(0, 28, 28); background-color: rgb(48, 185, 60);" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:Button name="pause-button" class="pauseButton" style="background-image: url(&quot;project://database/Assets/UI/GameUI/texture/pauseicon.png?fileID=2800000&amp;guid=a2c89a39c67db4a4dbfba05a41fba350&amp;type=3#pauseicon&quot;); width: 80px; height: 80px; background-color: rgba(188, 188, 188, 0); display: flex; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0;" />
        </ui:VisualElement>
        <ui:VisualElement name="win-screen-container" enabled="true" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.85); align-items: center; justify-content: center; display: none; position: absolute; width: 100%; height: 100%;">
            <ui:VisualElement name="win-panel" style="background-color: rgba(0, 0, 0, 0.95); border-left-color: rgb(11, 255, 11); border-right-color: rgb(11, 255, 11); border-top-color: rgb(11, 255, 11); border-bottom-color: rgb(11, 255, 11); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; padding: 20px; width: 750px; height: 600px; align-self: center; align-items: stretch; flex-direction: column;">
                <ui:Label text="VICTORY!" style="font-size: 48px; color: rgb(11, 255, 11); margin-bottom: 15px; -unity-text-align: middle-center; -unity-font-style: bold; flex-shrink: 0;" />
                <ui:VisualElement name="score-info-container" style="width: 100%; margin-bottom: 12px; padding: 12px; background-color: rgba(11, 255, 11, 0.08); border-left-color: rgb(11, 255, 11); border-right-color: rgb(11, 255, 11); border-top-color: rgb(11, 255, 11); border-bottom-color: rgb(11, 255, 11); border-top-width: 2px; border-right-width: 2px; border-bottom-width: 2px; border-left-width: 2px; border-radius: 5px; flex-shrink: 0;">
                    <ui:Label text="YOUR SCORE" style="font-size: 18px; color: rgb(180, 180, 180); align-self: center; margin-bottom: 5px; -unity-text-align: middle-center; -unity-font-style: bold;" />
                    <ui:Label text="Time Remaining: 03:45.250" name="current-time-label" style="font-size: 32px; color: rgb(255, 215, 0); align-self: center; margin-bottom: 8px; -unity-text-align: middle-center; -unity-font-style: bold;" />
                    <ui:Label text="Your Best: 04:12.180" name="best-time-label" style="font-size: 16px; color: rgb(180, 180, 180); align-self: center; -unity-text-align: middle-center;" />
                </ui:VisualElement>
                <ui:Label text="LEADERBOARD - TOP 5" style="font-size: 20px; color: rgb(11, 255, 11); margin-bottom: 8px; -unity-text-align: middle-center; -unity-font-style: bold; flex-shrink: 0;" />
                <ui:VisualElement style="flex-direction: row; padding-left: 10px; padding-right: 10px; padding-top: 8px; padding-bottom: 8px; background-color: rgba(11, 255, 11, 0.2); margin-bottom: 3px; border-radius: 3px; flex-shrink: 0;">
                    <ui:Label text="RANK" style="width: 70px; color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold;" />
                    <ui:Label text="PLAYER" style="flex-grow: 1; color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold;" />
                    <ui:Label text="TIME" style="width: 120px; color: rgb(255, 255, 255); font-size: 14px; -unity-font-style: bold; -unity-text-align: middle-right;" />
                </ui:VisualElement>
                <ui:ScrollView name="win-leaderboard-scroll" style="width: 100%; flex-grow: 1; background-color: rgba(0, 0, 0, 0.6); border-left-color: rgb(80, 80, 80); border-right-color: rgb(80, 80, 80); border-top-color: rgb(80, 80, 80); border-bottom-color: rgb(80, 80, 80); border-top-width: 1px; border-right-width: 1px; border-bottom-width: 1px; border-left-width: 1px; border-radius: 3px; margin-bottom: 12px;" />
                <ui:VisualElement name="win-buttons-container" style="flex-direction: row; justify-content: center; width: 100%; flex-shrink: 0;">
                    <ui:Button text="Retry" name="restart-button-win" class="pauseRegularButton" style="width: 180px; margin-right: 15px; font-size: 18px;" />
                    <ui:Button text="Main Menu" name="home-button-win" class="pauseRegularButton" style="width: 180px; margin-left: 15px; font-size: 18px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="lose-screen-container" enabled="true" style="flex-grow: 1; background-color: rgba(0, 0, 0, 0.85); align-items: center; justify-content: center; display: none; position: absolute; width: 100%; height: 100%;">
            <ui:VisualElement name="lose-panel" style="background-color: rgba(0, 0, 0, 0.9); border-left-color: rgb(255, 50, 50); border-right-color: rgb(255, 50, 50); border-top-color: rgb(255, 50, 50); border-bottom-color: rgb(255, 50, 50); border-top-width: 6px; border-right-width: 6px; border-bottom-width: 6px; border-left-width: 6px; padding: 30px; width: 500px; align-items: center;">
                <ui:Label text="TIME&apos;S UP!" style="font-size: 42px; color: rgb(255, 50, 50); margin-bottom: 30px; -unity-text-align: middle-center;" />
                <ui:Label text="Try Again!" style="font-size: 24px; color: rgb(200, 200, 200); margin-bottom: 40px; -unity-text-align: middle-center;" />
                <ui:VisualElement name="lose-buttons-container" style="flex-direction: row; justify-content: center; width: 100%;">
                    <ui:Button text="Retry" name="restart-button-lose" class="pauseRegularButton" style="width: 200px; margin-right: 10px;" />
                    <ui:Button text="Main Menu" name="home-button-lose" class="pauseRegularButton" style="width: 200px; margin-left: 10px;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
        <ui:VisualElement name="pause-menu-container" class="interactive" style="flex-grow: 1; align-items: center; justify-content: center; display: none; border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; border-left-color: rgba(0, 0, 0, 0); border-right-color: rgba(0, 0, 0, 0); border-top-color: rgba(0, 0, 0, 0); border-bottom-color: rgba(0, 0, 0, 0); -unity-slice-scale: 1px; align-content: flex-start;">
            <ui:VisualElement name="pause-menu-panel" style="flex-grow: 0; background-color: rgba(255, 255, 255, 0); width: 450px; height: 340px; align-items: center; border-left-color: rgba(255, 255, 255, 0); border-right-color: rgba(255, 255, 255, 0); border-top-color: rgba(255, 255, 255, 0); border-bottom-color: rgba(255, 255, 255, 0); border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0; background-image: url(&quot;project://database/Assets/UI/GameUI/texture/panel_backgroun_2.png?fileID=2800000&amp;guid=eb5b523f5f8bd405290574578033da12&amp;type=3#panel_backgroun_2&quot;); -unity-background-scale-mode: stretch-to-fill; -unity-background-image-tint-color: rgb(207, 207, 207); display: flex; justify-content: center; align-content: flex-start;">
                <ui:Label text="GAME PAUSED" name="paused-title" style="font-size: 38px; color: rgb(255, 255, 255); margin-bottom: 5px; margin-top: 10px; -unity-font-definition: url(&quot;project://database/Assets/UI/GameUI/font/VT323-Regular.ttf?fileID=12800000&amp;guid=8c2ab64ad12824a55827b2ea2f868ae3&amp;type=3#VT323-Regular&quot;); -unity-font-style: normal; letter-spacing: 0; -unity-text-outline-color: rgb(255, 255, 255); -unity-text-outline-width: 1.3px;" />
                <ui:VisualElement name="button-panel" style="flex-grow: 0; display: flex;">
                    <ui:Button text="Home" name="home-button" class="pauseRegularButton" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    <ui:Button text="Restart" name="restart-button" class="pauseRegularButton" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                    <ui:Button text="Resume" name="resume-button" class="pauseRegularButton" style="border-top-width: 0; border-right-width: 0; border-bottom-width: 0; border-left-width: 0;" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
