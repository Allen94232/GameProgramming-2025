:root {
    picking-mode: Ignore;
}

.interactive {
    picking-mode: Position;
}

Button {
    picking-mode: Position;
}

Label {
    picking-mode: Ignore;
}

.pauseRegularButton {
    width: 300px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    background-color: rgba(0, 0, 0, 0);
    color: rgb(26, 26, 26);
    font-size: 32px;
    margin-bottom: 8px;
    background-image: url("project://database/Assets/UI/GameUI/texture/button_background.png?fileID=2800000&guid=87bcef70b8c104272b7aaf2400efc56c&type=3#button_background");
    -unity-slice-left: 10;
    -unity-slice-top: 10;
    -unity-slice-right: 10;
    -unity-slice-bottom: 10;
    -unity-slice-scale: 2px;
    -unity-font-definition: url("project://database/Assets/UI/GameUI/font/VT323-Regular.ttf?fileID=12800000&guid=8c2ab64ad12824a55827b2ea2f868ae3&type=3#VT323-Regular");
    -unity-font-style: normal;
    -unity-text-outline-color: rgb(34, 34, 34);
    -unity-text-outline-width: 1.2px;
}

.pauseRegularButton:hover {
    transition-duration: 0.4s;
    scale: 1.05 1.05;
}

.pauseButton:hover {
    scale: 1.2 1.2;
}

.leaderboard-row {
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    height: 40px;
    padding-top: 5px;
    padding-bottom: 5px;
    padding-left: 10px;
    padding-right: 10px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(35, 25, 18);
    border-right-color: rgb(35, 25, 18);
    border-top-color: rgb(35, 25, 18);
    border-bottom-color: rgb(35, 25, 18);
}

.leaderboard-text {
    -unity-font-definition: url("project://database/Assets/UI/GameUI/font/NotoSansSC-Regular.otf?fileID=12800000&guid=dd308675e8e3d7d4e81549f156b3038c&type=3#NotoSansSC-Regular");
    -unity-font-style: bold;
    font-size: 18px;
    color: rgb(32, 23, 18);
    -unity-text-align: middle-center;
}

.row-gold {
    background-color: rgba(255, 215, 0, 0.47);
}

.row-silver {
    -unity-background-image-tint-color: rgba(192, 192, 192, 0.47);
}

.row-bronze {
    background-color: rgba(205, 127, 50, 0.47);
}

.row-player {
    background-color: rgba(227, 86, 25, 0.35);
    border-left-width: 4px;
    border-left-color: rgb(227, 86, 25);
}

#best-time-label.new-record-text {
    color: rgb(248, 171, 0);
    -unity-font-definition: url("project://database/Assets/UI/GameUI/font/VT323-Regular.ttf?fileID=12800000&guid=8c2ab64ad12824a55827b2ea2f868ae3&type=3#VT323-Regular");
}
